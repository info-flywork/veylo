# --- Sunucu ---
NODE_ENV=development
PORT=4000
# Virgülle ayrılmış izinli origin'ler (mobil uygulama için gerekmez, web/admin panel için)
CORS_ORIGINS=http://localhost:3000

# --- Veritabanı (MySQL / MariaDB) ---
# Yerel: mysql://root@localhost:3306/veylo_dev
# Güzel.net: mysql://KULLANICI:SIFRE@HOST:3306/VERITABANI
DATABASE_URL=mysql://root@localhost:3306/veylo_dev

# --- Firebase Admin (sadece Auth token doğrulaması + FCM) ---
# Firebase Console > Proje Ayarları > Hizmet hesapları > Yeni özel anahtar oluştur
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Sadece geliştirmede: "Authorization: Bearer dev:<herhangi-bir-uid>" ile Firebase olmadan giriş.
# production'da true olursa sunucu açılmaz.
AUTH_DEV_BYPASS=true

# --- RevenueCat ---
# RevenueCat > Integrations > Webhooks > Authorization header değeri
REVENUECAT_WEBHOOK_AUTH=change-me

# --- Medya: Bunny Storage + CDN ---
# Boş bırakılırsa (sadece geliştirmede) dosyalar ./uploads klasörüne yazılır.
# Bunny > Storage > (zone) > FTP & API Access > Password
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Storage zone'un ana bölgesi. Boş = Falkenstein (DE). Diğerleri: uk, ny, la, sg, se, br, jh, syd
BUNNY_STORAGE_REGION=
# Storage zone'a bağlı Pull Zone adresi, ör. https://veylo.b-cdn.net veya https://cdn.veylo.app
BUNNY_CDN_URL=
# Yerel depolamada dosya URL'lerinin başı (Bunny kullanılırken gerekmez)
PUBLIC_BASE_URL=http://localhost:4000

# Firebase Web API anahtarı (kullanıcı adıyla giriş için). Firebase > Proje ayarları > Web uygulaması
FIREBASE_WEB_API_KEY=
